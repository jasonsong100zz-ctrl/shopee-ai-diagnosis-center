{
  "manifest_version": 3,
  "name": "FM 竞品监控",
  "version": "1.0.0",
  "description": "FM 竞品监控：人工启动、逐条采集已登录 Shopee 页面并发布竞品快照。",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["https://docs.google.com/*", "https://shopee.co.id/*", "https://shopee.com.my/*", "https://shopee.sg/*", "https://shopee.co.th/*", "https://shopee.ph/*", "https://shopee.vn/*", "https://shopee.tw/*", "http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "FM 竞品监控", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }, "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://shopee.co.id/*", "https://shopee.com.my/*", "https://shopee.sg/*", "https://shopee.co.th/*", "https://shopee.ph/*", "https://shopee.vn/*", "https://shopee.tw/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
